{
	"schemaVersion": 1,
	"id": "eldrich-surge",
	"version": "${version}",
	"name": "Eldritch Surge",
	"description": "A data-driven overhaul of Minecraft enchantment progression and combat logic.",
	"authors": ["Golden"],
	"contact": {
		"sources": "https://github.com/Golden/Eldrich-Surge"
	},
	"license": "MIT",
	"icon": "assets/eldrich-surge/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["eldritch.surge.EldritchSurge"],
		"client": [{
			"value": "eldritch.surge.client.EldritchSurgeClient",
			"adapter": "kotlin"
		}],
		"fabric-datagen": [{
			"value": "eldritch.surge.client.EldritchSurgeDataGenerator",
			"adapter": "kotlin"
		}],
		"modmenu": ["eldritch.surge.client.EldritchModMenuIntegration"]
	},
	"mixins": ["eldrich-surge.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	},
	"suggests": {
		"enchlib": "*",
        "modmenu": "*",
        "cloth-config": "*",
        "yet_another_config_lib_v3": "*"
	}
}
